---
import BaseLayout from '../layouts/BaseLayout.astro';
import DatePicker from '../components/DatePicker.astro';
import { getTaipeiDateKey } from '../lib/calendar';
---

<BaseLayout title="查日子｜島日曆">
  <section class="lookup-page">
    <header>
      <p>1901–2100</p>
      <h1>找一個日子</h1>
      <span>輸入日期，查看農曆、干支、節氣與宜忌。</span>
    </header>
    <DatePicker value={getTaipeiDateKey()} />
    <div class="lookup-result" data-lookup-result aria-live="polite">
      <noscript>日曆查詢與日期頁需要 JavaScript。</noscript>
    </div>
  </section>
</BaseLayout>

<script>
  import { getCalendarDay } from '../lib/calendar';
  import { addDays, dayHref, getTaipeiDateKey, isEngineDate, isStaticDate, monthHref } from '../lib/dates';
  import { getDailyContent } from '../lib/content';

  const params = new URLSearchParams(window.location.search);
  const pathMatch = /^\/day\/(\d{4})\/(\d{2})\/(\d{2})\/?$/.exec(window.location.pathname);
  const pathDate = pathMatch ? `${pathMatch[1]}-${pathMatch[2]}-${pathMatch[3]}` : null;
  const requested = pathDate ?? params.get('date') ?? getTaipeiDateKey();
  const isSharedDayPage = pathDate !== null && isStaticDate(pathDate);
  const page = document.querySelector<HTMLElement>('.lookup-page');
  const result = document.querySelector<HTMLElement>('[data-lookup-result]');
  const input = document.querySelector<HTMLInputElement>('input[name="date"]');
  if (isSharedDayPage) page?.classList.add('lookup-page--day-route');
  if (input && isEngineDate(requested)) input.value = requested;

  if (result && isEngineDate(requested)) {
    const day = getCalendarDay(requested);
    const content = getDailyContent(requested);
    const title = `${day.year} 年 ${day.month} 月 ${day.day} 日｜${day.lunar.display}｜島日曆`;
    const description = `${day.date} ${day.weekday}，農曆${day.lunar.display}，${day.ganzhi.year}年，生肖${day.zodiac}。`;
    document.title = title;
    document.querySelector<HTMLMetaElement>('meta[name="description"]')?.setAttribute('content', description);
    document.querySelector<HTMLLinkElement>('link[rel="canonical"]')?.setAttribute(
      'href',
      new URL(dayHref(day.date), window.location.origin).href
    );

    if (isSharedDayPage) {
      const monthLink = document.querySelector<HTMLAnchorElement>('[data-nav-month="today"]');
      if (monthLink) {
        monthLink.href = monthHref(day.year, day.month);
        monthLink.textContent = `查看 ${day.month} 月`;
      }

      const previous = addDays(day.date, -1);
      const next = addDays(day.date, 1);
      const formatShort = (dateKey: string) => {
        const [, month, date] = dateKey.split('-').map(Number);
        return `${month}/${date}`;
      };
      result.innerHTML = `
        <section class="day-stage" data-day-page="${day.date}">
          <article class="daily-sheet">
            <h1 class="visually-hidden">${day.year} 年 ${day.month} 月 ${day.day} 日</h1>
            <figure class="daily-image">
              <img src="${content.image.file}" alt="${content.image.alt}" width="1400" height="900" loading="eager">
              <figcaption>
                <span>${day.solarTerm ?? '今日風物'}</span>
                <small${day.date === getTaipeiDateKey() ? '' : ' hidden'}>今天</small>
              </figcaption>
            </figure>
            <div class="date-block">
              <div class="gregorian">
                <span class="year">${day.year}</span>
                <span class="month-day">${String(day.month).padStart(2, '0')}<i>/</i>${String(day.day).padStart(2, '0')}</span>
                <span class="weekday">${day.weekday}</span>
              </div>
              <div class="lunar-date"><span>農曆</span><strong>${day.lunar.display}</strong></div>
            </div>
            <dl class="traditional-info">
              <div><dt>年干支</dt><dd>${day.ganzhi.year}</dd></div>
              <div><dt>月干支</dt><dd>${day.ganzhi.month}</dd></div>
              <div><dt>日干支</dt><dd>${day.ganzhi.day}</dd></div>
              <div><dt>生肖</dt><dd>${day.zodiac}</dd></div>
            </dl>
            <div class="almanac">
              <section class="yi"><h2><span>宜</span>順勢而為</h2><p>${day.almanac.yi.slice(0, 8).join('、') || '諸事皆宜'}</p></section>
              <section class="ji"><h2><span>忌</span>宜稍緩行</h2><p>${day.almanac.ji.slice(0, 8).join('、') || '無'}</p></section>
            </div>
            <blockquote><p>「${content.quote.text}」</p><footer>今日一句</footer></blockquote>
          </article>
          <nav class="day-navigation" aria-label="日期切換">
            <a href="${dayHref(previous)}"><span aria-hidden="true">←</span><small>上一天</small><strong>${formatShort(previous)}</strong></a>
            <a href="${dayHref(next)}"><small>下一天</small><strong>${formatShort(next)}</strong><span aria-hidden="true">→</span></a>
          </nav>
        </section>`;
    } else {
      const term = day.solarTerm ? `<span class="lookup-term">${day.solarTerm}</span>` : '';
      result.innerHTML = `
        <article class="lookup-card">
          <img src="${content.image.file}" alt="${content.image.alt}" width="1400" height="900">
          <div class="lookup-card-body">
            ${term}
            <p class="lookup-date">${day.year} / ${String(day.month).padStart(2, '0')} / ${String(day.day).padStart(2, '0')}，${day.weekday}</p>
            <h2>農曆${day.lunar.display}</h2>
            <dl>
              <div><dt>年干支</dt><dd>${day.ganzhi.year}</dd></div>
              <div><dt>月干支</dt><dd>${day.ganzhi.month}</dd></div>
              <div><dt>日干支</dt><dd>${day.ganzhi.day}</dd></div>
              <div><dt>生肖</dt><dd>${day.zodiac}</dd></div>
            </dl>
            <p><b>宜</b>${day.almanac.yi.slice(0, 8).join('、') || '諸事皆宜'}</p>
            <p><b>忌</b>${day.almanac.ji.slice(0, 8).join('、') || '無'}</p>
            <blockquote>「${content.quote.text}」</blockquote>
            <a class="permalink" href="${dayHref(day.date)}">開啟這一天的固定連結</a>
          </div>
        </article>`;
    }
  } else if (result) {
    result.innerHTML = '<p class="error-message">日期超出支援範圍，請選擇 1901–2100 年之間的日期。</p>';
  }
</script>
