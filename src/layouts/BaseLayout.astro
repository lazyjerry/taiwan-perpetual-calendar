---
import '../styles/global.css';
import { addDays, dayHref, getTaipeiDateKey, monthHref, parseDateKey } from '../lib/dates';
import { API_UPDATED_AT } from '../lib/api';

interface Props {
  title: string;
  description?: string;
  navMonth?: { year: number; month: number };
}

const {
  title,
  description = '台灣時區的靜態萬年曆，顯示農曆、干支、生肖、節氣與每日宜忌。',
  navMonth
} = Astro.props;
const todayKey = getTaipeiDateKey();
const today = parseDateKey(todayKey);
const navYear = navMonth?.year ?? today.year;
const navMonthNumber = navMonth?.month ?? today.month;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://taiwan-perpetual-calendar.pages.dev${Astro.url.pathname}`} />
    <meta name="theme-color" content="#a5382c" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要內容</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="島日曆首頁">
        <span class="brand-mark" aria-hidden="true">曆</span>
        <span>
          <strong>島日曆</strong>
          <small>以台灣時間記下每一天</small>
        </span>
      </a>
      <nav class="site-nav" aria-label="主選單">
        <a href={dayHref(addDays(todayKey, -1))} data-nav-day="yesterday">昨天</a>
        <a href="/">今日</a>
        <a href={dayHref(addDays(todayKey, 1))} data-nav-day="tomorrow">明天</a>
        <button type="button" class="nav-more" data-nav-toggle aria-expanded="false" aria-controls="site-drawer">更多</button>
        <div class="nav-drawer" id="site-drawer" data-nav-drawer>
          <button type="button" class="nav-drawer-close" data-nav-close aria-label="關閉選單">×</button>
          <a href={monthHref(navYear, navMonthNumber)} data-nav-month={navMonth ? undefined : 'today'}>查看 {navMonthNumber} 月</a>
          <a href="/lookup/">查日子</a>
        </div>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="share" data-share hidden>
        <button type="button" class="share-button" data-share-button>分享這一頁</button>
        <span class="share-status" data-share-status role="status" aria-live="polite"></span>
      </div>
      <p>語錄與影像由 AI 生成，宜忌僅供傳統文化參考，內容請自行斟酌。 | 最後更新時間：{API_UPDATED_AT}</p>
    </footer>
  </body>
</html>

<script>
  import { addDays, dayHref, getTaipeiDateKey, monthHref, parseDateKey } from '../lib/dates';
  const todayKey = getTaipeiDateKey();
  const link = document.querySelector<HTMLAnchorElement>('[data-nav-month="today"]');
  if (link) {
    const { year, month } = parseDateKey(todayKey);
    link.href = monthHref(year, month);
    link.textContent = `查看 ${month} 月`;
  }
  document.querySelectorAll<HTMLAnchorElement>('[data-nav-day]').forEach((anchor) => {
    anchor.href = dayHref(addDays(todayKey, anchor.dataset.navDay === 'yesterday' ? -1 : 1));
  });

  const drawer = document.querySelector<HTMLElement>('[data-nav-drawer]');
  const drawerToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  if (drawer && drawerToggle) {
    const isOpen = () => drawer.classList.contains('is-open');
    const setOpen = (open: boolean) => {
      drawer.classList.toggle('is-open', open);
      drawerToggle.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('nav-drawer-open', open);
      if (open) drawer.querySelector<HTMLElement>('a')?.focus();
      else if (drawer.contains(document.activeElement)) drawerToggle.focus();
    };
    drawerToggle.addEventListener('click', () => setOpen(!isOpen()));
    drawer.querySelector('[data-nav-close]')?.addEventListener('click', () => setOpen(false));
    drawer.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('click', (event) => {
      if (isOpen() && !(event.target as Element).closest('.site-nav')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) setOpen(false);
    });
    window.matchMedia('(min-width: 721px)').addEventListener('change', (event) => {
      if (event.matches && isOpen()) setOpen(false);
    });
  }

  const share = document.querySelector<HTMLElement>('[data-share]');
  const shareButton = share?.querySelector<HTMLButtonElement>('[data-share-button]');
  const shareStatus = share?.querySelector<HTMLElement>('[data-share-status]');
  if (share && shareButton && shareStatus) {
    share.hidden = false;
    let statusTimer: ReturnType<typeof setTimeout> | undefined;
    const showStatus = (text: string) => {
      shareStatus.textContent = text;
      clearTimeout(statusTimer);
      statusTimer = setTimeout(() => { shareStatus.textContent = ''; }, 3000);
    };
    shareButton.addEventListener('click', async () => {
      const dayPage = document.querySelector<HTMLElement>('[data-day-page]')?.dataset.dayPage;
      const url = dayPage ? new URL(dayHref(dayPage), window.location.origin).href : window.location.href;
      const title = document.title;
      const text = document.querySelector<HTMLMetaElement>('meta[name="description"]')?.content ?? '';
      try {
        if (typeof navigator.share === 'function') {
          await navigator.share({ title, text, url });
          return;
        }
        await navigator.clipboard.writeText(url);
        showStatus('已複製連結');
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        showStatus('無法分享，請手動複製網址');
      }
    });
  }
</script>
